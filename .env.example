# CourseForge only needs an LLM API key and model name.
# The application-facing names stay provider-neutral even though the current
# implementation uses OpenRouter through LangChain's ChatOpenRouter.
LLM_API_KEY=sk-or-v1-your-key

# OpenRouter's free router is convenient for this teaching project.
# You can pin a specific model here for more repeatable results.
LLM_MODEL=openrouter/free
